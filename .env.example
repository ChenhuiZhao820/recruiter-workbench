# Copy this file to .env and fill in the values.

# SQLite for a fresh local account database. Hosted builds use a PostgreSQL DATABASE_URL and build:hosted.
DATABASE_URL="file:./accounts.db"

# The exact origin the browser sees, including the port. Required in production
# and HTTPS there. It is also the origin the downloaded browser extension is
# packaged for, so getting it wrong ships an extension that cannot reach the
# site. Hosted deployment: APP_ORIGIN="https://capture-workbench.onrender.com"
APP_ORIGIN="http://localhost:3000"

# Server side only. Never exposed to the browser. Used for role briefings.
ANTHROPIC_API_KEY=""
