# Copy this file to .env and fill in the values.

# SQLite for a fresh local account database. Hosted builds use a PostgreSQL DATABASE_URL and build:hosted.
DATABASE_URL="file:./accounts.db"

# The exact origin the browser sees, including the port. Required in production
# and HTTPS there. It is also the origin the downloaded browser extension is
# packaged for, so getting it wrong ships an extension that cannot reach the
# site. Hosted deployment: APP_ORIGIN="https://capture-workbench.onrender.com"
APP_ORIGIN="http://localhost:3000"

# Server side only. Never exposed to the browser. Used for role briefings
# and screening summaries.
ANTHROPIC_API_KEY=""

# Screening assistant (Pro). All optional. The model defaults to the current
# Opus until the evaluation in scripts/eval-screening.mjs picks one; effort is
# sent only when set (low, medium, high, xhigh or max) and not to Haiku.
# The cap is screening summaries per account per calendar month (UTC).
CAPTURE_SCREENING_MODEL=""
CAPTURE_SCREENING_EFFORT=""
CAPTURE_SCREENING_MONTHLY_CAP="100"

# Suggested replies in the follow-up run (every plan). Optional. The model
# defaults to the cheapest current one (claude-haiku-4-5); the cap is
# suggestions per account per calendar month (UTC).
CAPTURE_REPLY_MODEL=""
CAPTURE_REPLY_MONTHLY_CAP="300"

# Booking page. Signs each candidate's booking link; at least 32 random
# characters, kept secret, and the same on every instance. Changing it stops
# every link already sent. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_LINK_SECRET=""

# Calendar free/busy (optional). Lets a recruiter connect Google or Microsoft
# read-only so the booking page leaves out times they are busy. Both need an
# OAuth app registered with the provider, with the redirect URI
# <APP_ORIGIN>/api/calendar/callback/google (or /microsoft). The key encrypts
# stored tokens: 32+ random characters; changing it disconnects everyone.
CALENDAR_TOKEN_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
