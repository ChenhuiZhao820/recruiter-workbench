datasource db {
  provider = "postgresql"            // change to "postgresql" for deploy
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  role             String            @default("recruiter")
  accountTier      String            @default("basic")
  trialExpiresAt   DateTime?
  active           Boolean           @default(true)
  passwordHash     String?
  authVersion      Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  // Better Auth's own user fields. Proven means a sign-up code or a provider
  // that vouched for the address; accounts made by an administrator are false.
  emailVerified            Boolean                 @default(false)
  image                    String?
  // "admin" for accounts an administrator made (they keep Basic when a trial
  // ends), "self" for sign-ups (they have no plan without one).
  signupSource             String                  @default("admin")
  termsVersion             String?
  termsAcceptedAt          DateTime?
  // Stripe's view of what is paid for, written only by the billing webhook
  // (lib/billing.ts) and read by getAccountTier.
  stripeCustomerId         String?                 @unique
  stripeSubscriptionId     String?                 @unique
  billingPlan              String?
  billingInterval          String?
  billingStatus            String?
  billingPeriodEnd         DateTime?
  billingCancelAtPeriodEnd Boolean                 @default(false)
  billingPastDueSince      DateTime?
  billingSyncedAt          DateTime?
  // A promo code's window of free Pro (lib/promo-core.mjs), read by
  // getAccountTier only while the account would otherwise have less.
  promoProFrom             DateTime?
  promoProUntil            DateTime?
  authSessions             AuthSession[]
  authAccounts             AuthAccount[]
  roles            Role[]
  searches         SavedSearch[]
  templates        MessageTemplate[]
  settings         Settings?
  sessions         Session[]
  activationTokens ActivationToken[]
  extensionAccess  ExtensionAccess?
  people           Person[]
  bookings         Booking[]
  calendar         CalendarConnection?
  aiUsage          AiUsage[]
  usageEvents      UsageEvent[]
  emailLookups     EmailLookup[]
  integrations     IntegrationConnection[]
  suppressions     Suppression[]
  importBatches    ImportBatch[]
  shortlists       Shortlist[]
  notifications    Notification[]
  interviewOffers  InterviewOffer[]
}

model ExtensionAccess {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String?   @unique
  expiresAt   DateTime?
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Session {
  tokenHash   String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewUserId  String?
  authVersion Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Better Auth's tables (lib/better-auth.ts). It proves who someone is - a
// sign-up code, Google, Microsoft - and the session it makes is exchanged at
// once for the workbench's own (Session above), so AuthSession rows are
// short-lived. AuthAccount links a person to a provider's account.
model AuthSession {
  id        String   @id
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// A sign-up waiting for its emailed code. The account is created only when the
// code is entered, from what was typed here; nothing else reads it.
model PendingSignup {
  email        String   @id
  name         String
  passwordHash String
  termsVersion String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

// One trial per person, ever: hashes of the normalised email and of each
// provider account that started one. Kept when the account is deleted.
model TrialClaim {
  keyHash   String   @id
  createdAt DateTime @default(now())
}

// A promo code redeemed, under the same hash of the address as TrialClaim and
// kept for good, so an address redeems a code once even after deleting the
// account. No user and no address: the window itself is on the user.
model PromoRedemption {
  id        String   @id @default(cuid())
  promoId   String
  keyHash   String
  createdAt DateTime @default(now())

  @@unique([promoId, keyHash])
}

// Stripe events already applied, so a redelivery does nothing.
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

model ActivationToken {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginThrottle {
  key      String   @id
  attempts Int      @default(0)
  resetAt  DateTime
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String?
  action       String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model Role {
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  id          String      @id @default(cuid())
  title       String
  client      String?
  jobDesc     String?
  status      String      @default("open")   // "open" | "closed"
  // Optional annual budget for the role. Matches leave out people whose
  // confirmed minimum expectation is above budgetMax; nothing is filtered
  // when it is empty.
  budgetMin      Int?
  budgetMax      Int?
  budgetCurrency String?
  // Whether the client reviews candidates before interviews. Off, a candidate
  // put forward may book the client interview straight away.
  clientReviewFirst     Boolean @default(true)
  // The client's interview hours. Windows are JSON [{day, startMin, endMin}],
  // as in Settings.bookingWindows, read in interviewTimezone; "[]" means none
  // yet, and no interview link is offered until there are some.
  interviewWindows      String  @default("[]")
  interviewTimezone     String?
  interviewDurationMins Int?
  interviewLocation     String?   // a meeting link or an address
  briefing    Briefing?
  candidates  Candidate[]
  searches    SavedSearch[]
  // Set when a People import created this role, so the import can be undone.
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  shortlist   Shortlist?
  notifications Notification[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

model Briefing {
  id                 String   @id @default(cuid())
  role               Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId             String   @unique
  dayToDay           String
  keySkills          String   // JSON string: [{ skill, real_vs_buzzword }]
  searchTitles       String   // JSON string: [string]
  targetCompanies    String   // JSON string: [string]
  salaryRange        String
  firstCallQuestions String   // JSON string: [{ question, strong_answer, weak_answer }]
  createdAt          DateTime @default(now())
}

model SavedSearch {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  id          String   @id @default(cuid())
  name        String
  role        Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  roleId      String?
  groupLabel  String?              // grouping by client or role type
  titles      String   @default("[]")  // JSON string: [string]
  keywords    String   @default("")
  industries  String   @default("[]")  // JSON string, shown as re-apply checklist
  locations   String   @default("[]")  // JSON string, shown as re-apply checklist
  filterNotes String?
  // A LinkedIn search address the recruiter built and saved in LinkedIn itself,
  // Recruiter or ordinary search. Opening it restores whatever filters LinkedIn
  // stored behind it, industries included. Stored opaquely: this app never
  // interprets, requests or rewrites it, it only validates that it is a
  // LinkedIn search address and opens it on a click.
  searchUrl   String?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Candidate {
  id             String   @id @default(cuid())
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         String
  fullName       String
  profileUrl     String?              // pasted by the recruiter
  // LinkedIn's own id for this member, read from their profile page by the
  // extension on the click that saved them. It is the only thing that can open
  // LinkedIn's message box directly, instead of opening the profile and hunting
  // for the Message button. Optional: candidates saved by hand do not have one.
  memberId       String?
  headline       String?
  notes          String?
  stage          String   @default("sourced")
  // stages: sourced | contacted | replied | booking_pending | booked | screened | submitted | interview | rejected | placed
  lastActivityAt DateTime @default(now())
  lastNudgeAt    DateTime?
  nudgeCount     Int      @default(0)
  // When they were first put forward to the client (on the role's client link).
  submittedAt    DateTime?
  // The person this candidacy belongs to. One person can be a candidate on
  // several roles; deleting the person removes every candidacy. Null only for
  // rows written before people existed, which are linked when next touched.
  personId       String?
  person         Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  outreach       OutreachLog[]
  screenings     Screening[]
  bookings       Booking[]
  personNotes    PersonNote[]
  // Set when a People import created this candidacy, so the import can be undone.
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  shortlistItems ShortlistItem[]
  interviewOffers InterviewOffer[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([personId])
}

model MessageTemplate {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  id        String   @id @default(cuid())
  name      String
  body      String   // contains {{first_name}}, {{role_title}}, {{calendar_link}}
  // "connection_note" | "message". A connection note is the short text that
  // rides along with an invitation and is capped by LinkedIn; a message is
  // sent once you are connected and has room to breathe.
  kind      String   @default("message")
  outreach  OutreachLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OutreachLog {
  id           String   @id @default(cuid())
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId  String
  template     MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId   String?
  renderedBody String
  // Copied from the template at send time so the record survives the
  // template being edited or deleted.
  kind         String   @default("message")
  // How it went out: "linkedin", "email" or "both", as the recruiter marked
  // it. Null for everything recorded before email existed, which was LinkedIn.
  channel      String?
  sentAt       DateTime @default(now())   // when the recruiter marked it sent
}

model Settings {
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  id               Int    @id @default(autoincrement())   // one row per user
  recruiterName    String @default("")
  calendarLink     String @default("")
  bookingChaseDays Int    @default(2)
  quietNudgeDays   Int    @default(5)
  // Hashed secret for the browser extension's capture endpoint. Null means
  // capture is switched off, so an unset token cannot be guessed as "".
  captureTokenHash String? @unique
  // The release notes this account has already been shown, as the release's own
  // id. Null means they have seen none, which is also what a brand new account
  // should see: what changed since a version they never used is not news.
  seenRelease      String?
  // Booking page. Windows are JSON [{day, startMin, endMin}] read in
  // bookingTimezone; day 0 is Monday.
  bookingWindows        String  @default("[]")
  bookingTimezone       String  @default("Europe/London")
  bookingDurationMins   Int     @default(30)
  bookingMinNoticeHours Int     @default(12)
  bookingHorizonDays    Int     @default(14)
  meetingLink           String  @default("")
  offerPhone            Boolean @default(false)
  // Shown on the booking page and available to templates as {{privacy_notice}}.
  privacyNotice         String  @default("")
  privacyContactEmail   String  @default("")
}

// One person, however many roles they are considered for. Facts are the
// candidate's own statements as confirmed by the recruiter, never verified.
model Person {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  fullName         String
  profileUrl       String?
  memberId         String?
  headline         String?
  email            String?
  emailSource      String?   // "booking" | "manual" | "import" | "finder" (found by Enrow, unverified)
  emailConsentAt   DateTime?
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?
  salaryNote       String?
  noticeWeeks      Int?
  availableFrom    DateTime?
  location         String?
  remotePreference String?   // onsite | hybrid | remote | flexible
  rightToWork      String?   // has_right | needs_sponsorship | unknown
  rightToWorkNote  String?
  skillsSummary    String?
  motivation       String?
  factsConfirmedAt DateTime?
  revisitOn        DateTime?
  revisitNote      String?
  doNotContact     Boolean   @default(false)
  // Lower-cased name, headline and facts, for plain substring search that
  // behaves the same on SQLite and PostgreSQL.
  searchText       String    @default("")
  lastContactAt    DateTime?
  candidates       Candidate[]
  notes            PersonNote[]
  // Set when a People import created this person, so the import can be undone.
  importBatchId    String?
  importBatch      ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  shortlistItems   ShortlistItem[]
  cv               PersonCv?
  emailLookups     EmailLookup[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, profileUrl])
  @@unique([userId, memberId])
  @@index([userId, revisitOn])
}

model Screening {
  id                    String    @id @default(cuid())
  candidateId           String
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status                String    @default("draft")   // draft | summarized | confirmed
  transcript            String?
  transcriptSource      String?   // paste | upload | manual
  transcriptDeleteAfter DateTime?
  summaryJson           String?
  summaryModel          String?
  generatedAt           DateTime?
  confirmedAt           DateTime?
  representConsentAt    DateTime?
  clientEmailSentAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([candidateId])
}

model Booking {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  startsAt      DateTime
  endsAt        DateTime
  mode          String    // video | phone
  meetingUrl    String?
  phone         String?
  email         String
  consentAt     DateTime
  noticeVersion String
  status        String    @default("booked")   // booked | cancelled
  kind          String    @default("screening") // screening | interview
  // An interview the recruiter arranged: the address when it is in person
  // (a meeting link stays in meetingUrl), and the zone it was arranged in.
  // Empty for one booked from the role's weekly hours, which read the role.
  place         String?
  timeZone      String?
  slot          BookedSlot?
  interviewSlot InterviewSlot?
  notifications Notification[]
  interviewOffer InterviewOffer?
  createdAt     DateTime  @default(now())

  @@index([candidateId])
  @@index([userId, startsAt])
}

// The double-booking lock: one row per owner and start time while a booking
// holds it. Cancelling deletes the row and frees the time.
model BookedSlot {
  userId    String
  startsAt  DateTime
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@id([userId, startsAt])
}

// The same lock for client interviews, kept apart from BookedSlot because the
// interviewer is the client, not the recruiter: two interviews with one client
// cannot start together, across all of that client's roles.
model InterviewSlot {
  userId    String
  clientKey String   // clientKey() of the role's client, or "role:<roleId>"
  startsAt  DateTime
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@id([userId, clientKey, startsAt])
}

// What a recruiter shows a client: a role's own client link (kind "role", one
// per role, roleKey = roleId) or a shortlist they put together (kind "custom",
// expiring). Read live by /s/<token>, so what is on screen follows the people.
model Shortlist {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind      String    // role | custom
  // Set for kind "role" only. A custom shortlist reaches roles through its
  // items' candidacies, never through this.
  roleId    String?   @unique
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  title     String
  client    String?
  access    String    @default("link")   // link | people
  expiresAt DateTime? // custom only
  revokedAt DateTime?
  items     ShortlistItem[]
  notifications Notification[]
  accesses  ShortlistAccess[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, kind])
}

// One person on a shortlist, with the agreement to put them forward to this
// client and what the client decided.
model ShortlistItem {
  id               String     @id @default(cuid())
  shortlistId      String
  shortlist        Shortlist  @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  personId         String
  person           Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  candidateId      String?
  candidate        Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  consentAt        DateTime
  pitch            String?
  position         Int        @default(0)
  decision         String?    // interview | declined
  decisionReason   String?    // salary | experience | location | notice | other
  decisionNote     String?
  decisionAt       DateTime?
  decisionAccessId String?
  addedAt          DateTime   @default(now())

  notifications    Notification[]

  @@unique([shortlistId, personId])
  @@index([personId])
  @@index([candidateId])
}

// A way into a shortlist: the one "anyone with the link" access (email null)
// or one per named person. The link is /s/<id>.<nonce>.<hmac>; replacing the
// nonce kills the old address, and revokedAt closes it for good.
model ShortlistAccess {
  id           String    @id @default(cuid())
  shortlistId  String
  shortlist    Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  email        String?
  nonce        String
  lastViewedAt DateTime?
  viewCount    Int       @default(0)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([shortlistId])
}

model CalendarConnection {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String    // google | microsoft
  tokenCipher String
  scope       String
  connectedAt DateTime  @default(now())
  lastErrorAt DateTime?
}

// A note the recruiter wrote or saved about a person, kept until they delete
// it or the person is erased. Not a transcript: those follow their 30 days.
// The role it was written for is kept when there was one, and survives the
// candidacy being removed.
model PersonNote {
  id          String     @id @default(cuid())
  personId    String
  person      Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  body        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([personId, createdAt])
}

// An account's connection to an app it imports from (notion). The tokens are
// encrypted with the server's key and never exported or imported.
model IntegrationConnection {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  tokenCipher String
  label       String    @default("")
  connectedAt DateTime  @default(now())
  lastErrorAt DateTime?

  @@id([userId, provider])
}

model AiUsage {
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       String // "YYYY-MM", UTC
  generations Int    @default(0)

  @@id([userId, month])
}

// Counts and timings only, never content.
model UsageEvent {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String
  value  Int?
  at     DateTime @default(now())

  @@index([userId, kind, at])
}

// One email search, started by a click on Find email. It holds no name, no
// address and no email: the found email goes onto the person, and this row
// is what the plan's allowance counts (found, or still pending) and what the
// page polls by. enrowId is the provider's search id, cleared once the
// result is read. The person may be erased afterwards; the row stays, so
// erasing someone does not give the search back.
model EmailLookup {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId   String?
  person     Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  method     String    // linkedin | name
  status     String    @default("pending") // pending | found | not_found | failed
  reason     String?   // the provider's reason for a LinkedIn search that found nothing
  enrowId    String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([userId, createdAt])
  @@index([personId])
}

// Kept after a person is deleted so the same profile is recognised if it is
// captured again. Only hashes of normalised identifiers are stored.
model Suppression {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash   String
  createdAt DateTime @default(now())

  @@id([userId, keyHash])
}

// One People import, kept so it can be undone for a while. It records what the
// import created (through importBatchId on Person, Role and Candidate) and,
// in `fills`, the empty fields it filled on people already there, as JSON
// [{ "id": personId, "fields": { "headline": "..." } }], so undo can empty a
// field again if it still holds what the import put there. Never exported or
// carried between databases: an undo belongs to the deployment it ran on.
model ImportBatch {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  createdCount Int         @default(0)
  roleCount    Int         @default(0)
  fills        String      @default("[]")
  createdAt    DateTime    @default(now())
  completedAt  DateTime?
  undoneAt     DateTime?
  people       Person[]
  roles        Role[]
  candidates   Candidate[]

  @@index([userId, createdAt])
}

// Something a client did - or a candidate, booking the client's interview -
// that the recruiter should look at: the bell in the top bar and the activity
// page. It holds references only; the words are written when it is read, so it
// follows a rename and goes with whatever it points at.
model Notification {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String         // client_answered | client_opened | interview_booked | interview_cancelled | client_set_hours
  detail      String?        // client_answered: interview | declined
  shortlistId String?
  shortlist   Shortlist?     @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  itemId      String?
  item        ShortlistItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking?       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roleId      String?
  role        Role?          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // The link it came through, so a named person's action can say who.
  accessId    String?
  createdAt   DateTime       @default(now())
  readAt      DateTime?

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Two or three times the recruiter offers one candidate for a client
// interview, without the role having weekly interview hours. The candidate's
// interview link shows these times while the offer is open; booking one
// closes it. A newer offer for the same candidate replaces the older.
model InterviewOffer {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  times        String    // JSON [epoch ms], sorted
  durationMins Int
  timeZone     String    // the zone the times were chosen in, for showing them
  location     String?   // a meeting link or an address
  createdAt    DateTime  @default(now())
  withdrawnAt  DateTime?
  bookingId    String?   @unique
  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([candidateId])
}

// The CV a client sees in place of the confirmed facts: one per person, a PDF
// kept as it was uploaded. contactsCheckedAt is when the recruiter confirmed
// the client may see everything in it, contact details included, which an
// upload cannot skip. It goes with the person (cascade).
model PersonCv {
  personId          String   @id
  person            Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  fileName          String
  sizeBytes         Int
  sha256            String
  data              Bytes
  contactsCheckedAt DateTime
  uploadedAt        DateTime @default(now())
}
